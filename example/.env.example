# Copy to .env and fill in the values Syntheia provided. The demo reads these from the environment.
PORT=4500

# Syntheia endpoints (production).
SYNTHEIA_API=https://api.us.supercomparer.com
SYNTHEIA_APP=https://app.us.supercomparer.com

# Your per-user API key (provided by Syntheia). Stays server-side; never sent to the browser.
SYN_API_KEY=syn_prd_REPLACE_ME

# Your workspace ID (provided by Syntheia).
WORKSPACE_ID=REPLACE_ME
